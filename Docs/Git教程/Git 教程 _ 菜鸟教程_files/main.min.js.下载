/* ========================================================
   ★ 明暗主题切换（现代 CSS 变量方案）
   ‣ 用 data-theme="dark" 控制全局，CSS 负责所有视觉切换
   ‣ 优先级：用户手动选择 > localStorage > prefers-color-scheme
   ‣ 保留 Cookie 写入以向后兼容旧逻辑
======================================================== */
const ThemeManager = (() => {
  const STORAGE_KEY = 'runoob-theme';
  const DARK_VAL = 'dark';
  const LIGHT_VAL = 'light';

  // 兼容旧 cateID cookie
  function getCateID() {
    const moon = document.getElementById('moon');
    return moon ? moon.getAttribute('data-cate') : null;
  }

  // 获取已保存主题
  function getSavedTheme() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return stored;
    } catch (_) {}

    // 兼容旧 Cookie
    const cateID = getCateID();
    if (cateID && readCookie('moon' + cateID)) {
      return DARK_VAL;
    }

    return null;
  }

  // 持久化主题
  function saveTheme(theme) {
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch (_) {}

    // 同步旧 Cookie（向后兼容）
    const cateID = getCateID();
    if (cateID) {
      if (theme === DARK_VAL) {
        createCookie('moon' + cateID, 1, 1);
      } else {
        eraseCookie('moon' + cateID);
      }
    }
  }

  // 更新切换按钮状态
  function updateButtons(theme) {
    const isDark = theme === DARK_VAL;

    $('#moon, #moon-mobile').css('display', isDark ? 'none' : 'block');
    $('#sun, #sun-mobile').css('display', isDark ? 'block' : 'none');
  }

  // 应用主题
  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);

    const existing = document.getElementById('dark-theme-css');

    if (theme === DARK_VAL) {
      if (!existing) {
        const link = document.createElement('link');
        link.id = 'dark-theme-css';
        link.rel = 'stylesheet';
        link.href = window.RUNOOB_CONFIG.darkCssUrl;
        document.head.appendChild(link);
      }
    } else {
      if (existing) {
        existing.remove();
      }
    }

    updateButtons(theme);
  }

  // 初始化（默认浅色）
  function init() {
    const theme = getSavedTheme() || LIGHT_VAL;
    applyTheme(theme);
  }

  // 切换主题
  function toggle(theme) {
    applyTheme(theme);
    saveTheme(theme);
  }

  return {
    init,
    toggle,
    DARK_VAL,
    LIGHT_VAL
  };
})();

// 尽早初始化，避免主题闪烁（FOUC）
ThemeManager.init();


