function delHis(url) {
  const stored = localStorage.getItem('artObject');
  if (!stored) return;
  let urls = JSON.parse(stored).urls.filter((item) => item.url !== url);
  localStorage.setItem('artObject', JSON.stringify({ urls }));
  location.reload();
}


/* ========================================================
   测验插件（Quiz）
======================================================== */
;(function ($, window, document) {
  'use strict';

  $.quiz = function (el, options) {
    const base = this;
    base.$el = $(el);
    base.$el.data('quiz', base);
    base.options = $.extend({}, $.quiz.defaultOptions, options);

    const {
      questions, startScreen, startButton, homeButton,
      resultsScreen, gameOverScreen,
      nextButtonText, finishButtonText, restartButtonText
    } = base.options;

    const numQuestions = questions.length;
    let currentQuestion = 1, score = 0, answerLocked = false;

    base.methods = {
      init() {
        base.methods.setup();
        $(document)
          .on('click', startButton,               (e) => { e.preventDefault(); base.methods.start(); })
          .on('click', homeButton,                (e) => { e.preventDefault(); base.methods.home(); })
          .on('click', '.answers a',             (e) => { e.preventDefault(); base.methods.answerQuestion(e.currentTarget); })
          .on('click', '#quiz-next-btn',          (e) => { e.preventDefault(); base.methods.nextQuestion(); })
          .on('click', '#quiz-finish-btn',        (e) => { e.preventDefault(); base.methods.finish(); })
          .on('click', '#quiz-restart-btn, #quiz-retry-btn', (e) => { e.preventDefault(); base.methods.restart(); });
      },

      setup() {
        let html = base.options.counter ? '<div id="quiz-counter"></div>' : '';
        html += '<div id="questions">';
        $.each(questions, (i, q) => {
          html += `<div class="question-container"><p class="question">${q.q}</p><ul class="answers">`;
          $.each(q.options, (idx, ans) => { html += `<li><a href="#" data-index="${idx}">${ans}</a></li>`; });
          html += '</ul></div>';
        });
        html += '</div>';

        if (!$(resultsScreen).length) {
          html += `<div id="${resultsScreen.substr(1)}"><p id="quiz-results"></p></div>`;
        }

        html += `<div id="quiz-controls"><p id="quiz-response"></p><div id="quiz-buttons">
          <a href="#" id="quiz-next-btn">${nextButtonText}</a>
          <a href="#" id="quiz-finish-btn">${finishButtonText}</a>
          <a href="#" id="quiz-restart-btn">${restartButtonText}</a>
        </div></div>`;

        base.$el.append(html).addClass('quiz-container quiz-start-state');
        $('#quiz-counter, .question-container, ' + gameOverScreen + ', ' + resultsScreen + ', #quiz-controls').hide();
      },

      start() {
        base.$el.removeClass('quiz-start-state').addClass('quiz-questions-state');
        $(startScreen).hide();
        $('#quiz-controls, #quiz-finish-btn, #quiz-restart-btn').hide();
        $('#questions, #quiz-counter').show();
        $('.question-container:first-child').show().addClass('active-question');
        base.methods.updateCounter();
      },

      answerQuestion(answerEl) {
        if (answerLocked) return;
        answerLocked = true;
        const $el = $(answerEl);
        const qi  = currentQuestion - 1;
        const correct = questions[qi].correctIndex;

        if ($el.data('index') === correct) {
          $el.addClass('correct');
          $('#quiz-response').html(questions[qi].correctResponse);
          score++;
        } else {
          $el.addClass('incorrect');
          $('#quiz-response').html(questions[qi].incorrectResponse);
          if (!base.options.allowIncorrect) { base.methods.gameOver(questions[qi].incorrectResponse); return; }
        }

        $('#quiz-controls').fadeIn();
        if (typeof base.options.answerCallback === 'function') {
          base.options.answerCallback(currentQuestion, $el.data('index'), questions[qi]);
        }
      },

      nextQuestion() {
        answerLocked = false;
        $('.active-question').hide().removeClass('active-question').next('.question-container').show().addClass('active-question');
        $('#quiz-controls').hide();
        if (++currentQuestion === numQuestions) { $('#quiz-next-btn').hide(); $('#quiz-finish-btn').show(); }
        base.methods.updateCounter();
        if (typeof base.options.nextCallback === 'function') base.options.nextCallback();
      },

      gameOver(response) {
        if (!$(gameOverScreen).length) {
          base.$el.append(`<div id="${gameOverScreen.substr(1)}"><p id="quiz-gameover-response"></p><p><a href="#" id="quiz-retry-btn">${restartButtonText}</a></p></div>`);
        }
        $('#quiz-gameover-response').html(response);
        $('#quiz-counter, #questions, #quiz-finish-btn').hide();
        $(gameOverScreen).show();
      },

      finish() {
        base.$el.removeClass('quiz-questions-state').addClass('quiz-results-state');
        $('.active-question').hide().removeClass('active-question');
        $('#quiz-counter, #quiz-response, #quiz-finish-btn, #quiz-next-btn').hide();
        $('#quiz-restart-btn').show();
        $(resultsScreen).show();
        $('#quiz-results').html(base.options.resultsFormat.replace('%score', score).replace('%total', numQuestions));
        if (typeof base.options.finishCallback === 'function') base.options.finishCallback();
      },

      restart() {
        base.methods.reset();
        base.$el.addClass('quiz-questions-state');
        $('#questions, #quiz-counter').show();
        $('.question-container:first-child').show().addClass('active-question');
        base.methods.updateCounter();
      },

      reset() {
        answerLocked = false; currentQuestion = 1; score = 0;
        $('.answers a').removeClass('correct incorrect');
        base.$el.removeClass().addClass('quiz-container');
        $('#quiz-restart-btn, ' + gameOverScreen + ', ' + resultsScreen + ', #quiz-controls').hide();
        $('#quiz-response, #quiz-next-btn').show();
        $('#quiz-counter').hide();
        $('.active-question').hide().removeClass('active-question');
      },

      home() {
        base.methods.reset();
        base.$el.addClass('quiz-start-state');
        $(startScreen).show();
        if (typeof base.options.homeCallback === 'function') base.options.homeCallback();
      },

      updateCounter() {
        $('#quiz-counter').html(
          base.options.counterFormat.replace('%current', currentQuestion).replace('%total', numQuestions)
        );
      }
    };

    base.methods.init();
  };

  $.quiz.defaultOptions = {
    allowIncorrect:   true,
    counter:          true,
    counterFormat:    '%current/%total',
    startScreen:      '#quiz-start-screen',
    startButton:      '#quiz-start-btn',
    homeButton:       '#quiz-home-btn',
    resultsScreen:    '#quiz-results-screen',
    resultsFormat:    'You got %score out of %total correct!',
    gameOverScreen:   '#quiz-gameover-screen',
    nextButtonText:   'Next',
    finishButtonText: 'Finish',
    restartButtonText:'Restart'
  };

  $.fn.quiz = function (options) {
    return this.each(function () { new $.quiz(this, options); });
  };
}(jQuery, window, document));