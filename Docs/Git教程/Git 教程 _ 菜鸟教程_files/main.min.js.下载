jQuery(document).ready(function ($) {
  const $modal     = $('.cd-user-modal');
  const $formLogin = $modal.find('#cd-login');
  const $formSignup= $modal.find('#cd-signup');
  const $tabLogin  = $('.cd-switcher').children('li').eq(0).children('a');
  const $tabSignup = $('.cd-switcher').children('li').eq(1).children('a');
  let loginFlag    = false;

  $.ajaxSetup({ async: false });

  // 检测登录状态
  if (readCookie('checklogin_ajax')) {
    $.post('/wp-content/themes/runoob/option/user/log.php', { action: 'checklogin' }, function (res) {
      if (res.error === 0) {
        $('<a target="_blank" href="//www.runoob.com/member">' + res.msg + '</a>').replaceAll('.runoob-pop');
        loginFlag = true;
      } else {
        eraseCookie('checklogin_ajax');
      }
    }, 'json');
  }

  if (typeof aid !== 'undefined' && aid > 0 && loginFlag) {
    $.post('/wp-content/themes/runoob/option/user/userinfo.php', { aid, action: 'collarticle', opt: 'init' }, function (data) {
      if (data.error === 0) {
        $('#content').find('h1:first').append(data.msg);
        $('.comment-signarea').hide();
        $('#commentform').show();
        $('#comment-author-info li:lt(2)').hide();
        $('#is_user_logged_in').val(1);
        $('.comt-title p:first').html(data.username);
      } else {
        $('.comment-signarea').show();
        $('#commentform').hide();
        $('#is_user_logged_in').val(0);
      }
    }, 'json');
  }

  /* 弹窗开关 */
  $('.runoob-pop').on('click', function (e) {
    $modal.addClass('is-visible');
    $(e.target).is('.cd-signup') ? signupSelected() : loginSelected();
  });

  $modal.on('click', function (e) {
    if ($(e.target).is($modal) || $(e.target).is('.cd-close-form')) {
      $modal.removeClass('is-visible');
    }
  });

  $(document).on('keyup', function (e) {
    if (e.which === 27) $modal.removeClass('is-visible');
  });

  $('.cd-switcher').on('click', function (e) {
    e.preventDefault();
    $(e.target).is($tabLogin) ? loginSelected() : signupSelected();
  });

  function loginSelected() {
    $formLogin.addClass('is-selected'); $formSignup.removeClass('is-selected');
    $tabLogin.addClass('selected');     $tabSignup.removeClass('selected');
  }
  function signupSelected() {
    $formSignup.addClass('is-selected'); $formLogin.removeClass('is-selected');
    $tabSignup.addClass('selected');     $tabLogin.removeClass('selected');
  }

  /* 表单提交 */
  $('.full-width2').on('click', function (e) {
    e.preventDefault();
    const $form  = $(this).closest('form, .cd-form');
    const action = $form.find('input[name="action"]').val();
    if (!action) return;

    const isReg = action === 'signup';
    let inputs;

    if (isReg) {
      inputs = {
        verifycode: $form.find('[name="verifycode"]').val(),
        email:      $form.find('[name="email"]').val(),
        name:       $form.find('[name="name"]').val(),
        password:   $form.find('[name="password"]').val(),
        password2:  $form.find('[name="password2"]').val(),
        action
      };
    } else {
      inputs = {
        username: $form.find('[name="username"]').val(),
        password: $form.find('[name="password"]').val(),
        remember: $('#remember-me').prop('checked') ? 1 : 0,
        action
      };
    }

    $.ajax({
      type: 'POST',
      url:  jsui.uri + '/option/user/log.php',
      data: inputs,
      dataType: 'json',
      success(data) {
        createCookie('checklogin_ajax', true, 15);
        if (data.error) {
          $('.err-msg').html(`<p class="errtip"><strong>错误</strong>：${data.msg}</p>`);
          return;
        }
        location.reload();
      }
    });
  });
});


