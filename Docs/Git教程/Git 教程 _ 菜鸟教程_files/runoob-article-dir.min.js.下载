(function(){if(window.matchMedia("(max-width: 768px)").matches)return;const left=document.getElementById("leftcolumn");if(!left)return;const allLinks=left.querySelectorAll("a");if(allLinks.length<=15)return;const style=document.createElement("style");style.innerHTML=`#runoob-nav-btn{position:fixed;top:50%;left:0;transform:translateY(-50%);background:#333;color:#fff;padding:10px 8px;cursor:pointer;border-radius:0 6px 6px 0;z-index:9999}#runoob-nav-btn i{font-size:16px}#runoob-nav-drawer{position:fixed;top:0;left:-420px;width:380px;height:100%;background:#fff;z-index:9999;transition:all 0.3s;display:flex;flex-direction:column;box-shadow:2px 0 10px rgba(0,0,0,0.1)}#runoob-nav-mask{position:fixed;inset:0;background:rgba(0,0,0,0.3);display:none;z-index:9998}.runoob-search-box{position:relative;margin:12px}.runoob-search-box i{position:absolute;left:10px;top:9px;color:#999}#runoob-nav-search{width:100%;padding:8px 8px 8px 28px;border:1px solid#ddd;border-radius:6px;font-size:13px;box-sizing:border-box}#runoob-nav-list{overflow-y:auto;padding:12px;flex:1}.runoob-nav-group{margin-bottom:18px}.runoob-nav-title{font-size:14px;font-weight:600;margin-bottom:6px;color:#111;display:flex;align-items:center;gap:6px}.runoob-nav-items{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.runoob-nav-item{display:flex;align-items:center;gap:6px;padding:6px 8px;background:#f5f5f5;border-radius:6px;font-size:12px;color:#333;text-decoration:none}.runoob-nav-item:hover{background:#e5e7eb}.runoob-nav-item.active{background:#d1d5db;font-weight:bold}@media(max-width:768px){#runoob-nav-btn,#runoob-nav-drawer,#runoob-nav-mask{display:none!important}}`;document.head.appendChild(style);function getMainTitle(){const firstLink=left.querySelector("a");if(!firstLink)return"教程";return firstLink.innerText.trim()}const MAIN_TITLE=getMainTitle();function parseNav(){const data=[];let currentGroup={title:MAIN_TITLE,items:[]};const children=left.children;for(let i=0;i<children.length;i++){const el=children[i];if(el.tagName==="H2"&&el.querySelector(".left_h2")){if(currentGroup.items.length){data.push(currentGroup)}currentGroup={title:el.innerText.trim(),items:[]};continue}if(el.tagName==="A"){currentGroup.items.push({text:el.innerText.trim(),href:el.getAttribute("href")})}}if(currentGroup.items.length){data.push(currentGroup)}return data}const NAV_DATA=parseNav();const btn=document.createElement("div");btn.id="runoob-nav-btn";btn.innerHTML=`<i class="fa fa-bars"></i>`;document.body.appendChild(btn);const drawer=document.createElement("div");drawer.id="runoob-nav-drawer";const searchBox=document.createElement("div");searchBox.className="runoob-search-box";const searchIcon=document.createElement("i");searchIcon.className="fa fa-search";const search=document.createElement("input");search.id="runoob-nav-search";search.placeholder="搜索文章...";searchBox.appendChild(searchIcon);searchBox.appendChild(search);const list=document.createElement("div");list.id="runoob-nav-list";drawer.appendChild(searchBox);drawer.appendChild(list);document.body.appendChild(drawer);const mask=document.createElement("div");mask.id="runoob-nav-mask";document.body.appendChild(mask);function render(data){const current=location.pathname;list.innerHTML=data.map(group=>`<div class="runoob-nav-group"><div class="runoob-nav-title"><i class="fa fa-folder"></i>${group.title}</div><div class="runoob-nav-items">${group.items.map(item=>`<a href="${item.href}"class="runoob-nav-item ${current.includes(item.href) ? 'active' : ''}"><i class="fa fa-file-text-o"></i>${item.text}</a>`).join("")}</div></div>`).join("");list.querySelectorAll("a").forEach(a=>{a.onclick=closeDrawer})}render(NAV_DATA);search.addEventListener("input",function(){const keyword=this.value.toLowerCase();const filtered=NAV_DATA.map(group=>({title:group.title,items:group.items.filter(i=>i.text.toLowerCase().includes(keyword))})).filter(g=>g.items.length>0);render(filtered)});function openDrawer(){drawer.style.left="0";mask.style.display="block"}function closeDrawer(){drawer.style.left="-420px";mask.style.display="none"}btn.onclick=openDrawer;mask.onclick=closeDrawer})();
